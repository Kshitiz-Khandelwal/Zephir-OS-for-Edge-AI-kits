/*
 * Board overlay for rpi_pico2/rp2350a/m33
 * Configures GP4 as PWM output (slice 2, channel A) for motor speed control
 */

#include <dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>

/ {
	motor_pwm: motor_pwm {
		compatible = "pwm-leds";
		motor_ch: motor_channel {
			pwms = <&pwm 4 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "MOTOR PWM";
		};
	};

	aliases {
		motor-pwm = &motor_ch;
	};
};

&pinctrl {
	pwm_motor_default: pwm_motor_default {
		group1 {
			pinmux = <PWM_2A_P4>;  /* GP4 = PWM slice 2, channel A */
		};
	};
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_motor_default>;
	pinctrl-names = "default";
	divider-int-2 = <255>;   /* Clock divider for slice 2 */
};
